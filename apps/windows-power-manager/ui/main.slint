import { Button, Slider } from "std-widgets.slint";

component ProfileTile inherits Rectangle {
    in property <string> heading;
    in property <string> description;
    in property <color> accent: #47e2ae;
    callback activated();
    background: #19273a;
    border-color: root.accent;
    border-width: 1px;
    border-radius: 14px;
    height: 83px;
    VerticalLayout {
        padding: 13px;
        spacing: 5px;
        Text {
            text: root.heading;
            color: root.accent;
            font-size: 16px;
            font-weight: 750;
        }
        Text {
            text: root.description;
            color: #c1cee0;
            font-size: 12px;
        }
    }
    TouchArea {
        clicked => { root.activated(); }
    }
}

export component MainWindow inherits Window {
    title: "Zilla Power Manager — Windows 11";
    width: 940px;
    height: 950px;
    background: #0b1320;
    default-font-family: "Segoe UI";

    in-out property <float> soc: 78;
    in-out property <float> watts: 200;
    in-out property <float> cpu-limit: 55;
    in property <string> soc-text: "78%";
    in property <string> watts-text: "200 Вт (ручні)";
    in property <string> runtime-text: "—";
    in property <string> cpu-text: "CPU: визначення...";
    in property <string> cpu-watts-text: "CPU package: Вт н/д";
    in property <string> ram-text: "RAM: —";
    in property <string> gpu-text: "AMD/NVIDIA: визначення...";
    in property <string> display-text: "Windows: визначення головного дисплея...";
    in property <string> limit-text: "CPU ≤ 55% (ще не застосовано)";
    in property <string> plan-text: "Windows (початковий)";
    in property <string> auto-text: "АВТО · ВИМКНЕНО";
    in property <string> status-text: "Застосуй профіль або перемісти повзунок. Windows не переводимо в сон.";

    callback settings-changed();
    callback preset-requested(int);
    callback manual-requested(float);
    callback auto-requested();
    callback preview-primary-requested();
    callback confirm-primary-requested();
    callback restore-extended-requested();
    callback restore-requested();

    VerticalLayout {
        padding: 20px;
        spacing: 10px;

        Rectangle {
            background: #14243a;
            border-radius: 16px;
            height: 78px;
            HorizontalLayout {
                padding: 16px;
                spacing: 12px;
                Rectangle {
                    width: 43px;
                    height: 43px;
                    background: #2c7bf2;
                    border-radius: 12px;
                    Text {
                        text: "ϟ";
                        font-size: 35px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        color: #ffffff;
                    }
                }
                VerticalLayout {
                    spacing: 5px;
                    Text { text: "ZILLA  POWER MANAGER"; font-size: 24px; font-weight: 800; color: #f5f8ff; }
                    Text { text: "Енергія під контролем  ·  Windows 11  ·  Native Rust"; font-size: 12px; color: #9cb1cc; }
                }
                Rectangle {
                    width: 175px;
                    background: #17392f;
                    border-radius: 10px;
                    Text {
                        text: "●  БЕЗ КОМАНД СНУ";
                        font-size: 12px;
                        font-weight: 700;
                        color: #49e4ae;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 10px;
            Rectangle {
                background: #172437;
                border-radius: 12px;
                height: 100px;
                VerticalLayout {
                    padding: 13px;
                    spacing: 5px;
                    Text { text: "ПРОЦЕСОР"; font-weight: 700; font-size: 11px; color: #8facc9; }
                    Text { text: root.cpu-text; color: #f2f5fa; font-size: 14px; wrap: word-wrap; }
                    Text { text: root.cpu-watts-text; color: #65d9fc; font-size: 12px; }
                }
            }
            Rectangle {
                background: #172437;
                border-radius: 12px;
                height: 100px;
                VerticalLayout {
                    padding: 13px;
                    spacing: 5px;
                    Text { text: "ВІДЕОКАРТА"; font-weight: 700; font-size: 11px; color: #8facc9; }
                    Text { text: root.gpu-text; color: #f2f5fa; font-size: 13px; wrap: word-wrap; }
                }
            }
        }

        HorizontalLayout {
            spacing: 10px;
            Text { text: "ШВИДКІ РЕЖИМИ"; font-size: 12px; font-weight: 700; color: #8facc9; }
            Text { text: "Активний: " + root.plan-text; color: #5ce4b2; font-size: 12px; horizontal-alignment: right; }
        }

        HorizontalLayout {
            spacing: 10px;
            ProfileTile {
                heading: "⚡ MAX";
                description: "100% · без обмеження";
                accent: #4bd79f;
                activated => { root.preset-requested(0); }
            }
            ProfileTile {
                heading: "◈ BALANCED";
                description: "80% · повсякденно";
                accent: #60b6ff;
                activated => { root.preset-requested(1); }
            }
            ProfileTile {
                heading: "⬡ ECO";
                description: "55% · економія";
                accent: #dfa263;
                activated => { root.preset-requested(2); }
            }
            ProfileTile {
                heading: "◆ HARD";
                description: "25% · максимум економії";
                accent: #ff6f7f;
                activated => { root.preset-requested(3); }
            }
        }

        Rectangle {
            background: #18273c;
            border-radius: 14px;
            height: 124px;
            VerticalLayout {
                padding: 14px;
                spacing: 8px;
                HorizontalLayout {
                    Text { text: "ТОЧНЕ КЕРУВАННЯ CPU"; color: #f1f6ff; font-size: 15px; font-weight: 750; }
                    Text { text: root.limit-text; color: #60e3b1; font-size: 13px; horizontal-alignment: right; }
                }
                Slider {
                    minimum: 20;
                    maximum: 100;
                    value: root.cpu-limit;
                    released(value) => { root.cpu-limit = value; root.manual-requested(value); }
                }
                HorizontalLayout {
                    Text { text: "20% · мінімально"; color: #92abc7; font-size: 11px; }
                    Text { text: "100% · максимально"; color: #92abc7; font-size: 11px; horizontal-alignment: right; }
                }
                Text {
                    text: "Ліміт продуктивності CPU. Реальна потужність у ватах залежить від навантаження та обладнання.";
                    color: #aebfd6; font-size: 11px; wrap: word-wrap;
                }
            }
        }

        Rectangle {
            background: #16382f;
            border-radius: 13px;
            height: 68px;
            HorizontalLayout {
                padding: 12px;
                spacing: 15px;
                VerticalLayout {
                    spacing: 5px;
                    Text { text: root.auto-text; font-size: 14px; color: #4be3a9; font-weight: 800; }
                    Text { text: "Підвищує ліміт при навантаженні, знижує в простої · 35–95%"; font-size: 12px; color: #b8dfd4; }
                }
                Button { text: "ПЕРЕМИКНУТИ AUTO"; clicked => { root.auto-requested(); } }
            }
        }

        Rectangle {
            background: #172437;
            border-radius: 13px;
            height: 148px;
            VerticalLayout {
                padding: 13px;
                spacing: 8px;
                Text { text: "МОНІТОРИ · КЕРУВАННЯ ЧЕРЕЗ WINDOWS (БЕЗ DDC/CI)"; color: #9eb6d2; font-size: 12px; font-weight: 800; }
                Text { text: root.display-text; color: #cde2f5; font-size: 12px; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 8px;
                    Button { text: "ОДИН ЕКРАН · ТЕСТ 20 С"; clicked => { root.preview-primary-requested(); } }
                    Button { text: "ЗАЛИШИТИ"; clicked => { root.confirm-primary-requested(); } }
                    Button { text: "РОЗШИРИТИ ЕКРАНИ"; clicked => { root.restore-extended-requested(); } }
                }
                Text { text: "Використовується головний дисплей саме Windows. Він має бути фізично ввімкненим. Без підтвердження інші екрани повернуться за 20 с."; color: #e5bb85; font-size: 11px; wrap: word-wrap; }
            }
        }

        Rectangle {
            background: #172437;
            border-radius: 13px;
            height: 140px;
            VerticalLayout {
                padding: 13px;
                spacing: 7px;
                HorizontalLayout {
                    Text { text: "LIFEPO4  ·  ПРОГНОЗ АВТОНОМНОСТІ"; font-size: 12px; font-weight: 800; color: #9eb6d2; }
                    Text { text: root.runtime-text; color: #51e5ac; font-size: 18px; font-weight: 800; horizontal-alignment: right; }
                }
                HorizontalLayout {
                    Text { text: "Заряд (ручний)"; color: #d6deea; font-size: 12px; }
                    Slider {
                        minimum: 0; maximum: 100; value: root.soc;
                        released(value) => { root.soc = value; root.settings-changed(); }
                    }
                    Text { text: root.soc-text; color: #51e5ac; font-size: 13px; }
                }
                HorizontalLayout {
                    Text { text: "Навантаження UPS (ручне)"; color: #d6deea; font-size: 12px; }
                    Slider {
                        minimum: 50; maximum: 1000; value: root.watts;
                        released(value) => { root.watts = value; root.settings-changed(); }
                    }
                    Text { text: root.watts-text; color: #e7eef8; font-size: 13px; }
                }
                Text { text: "Ціль: 150–200 Вт від UPS. Ці цифри в калькуляторі — не вимірювання."; color: #d2b58c; font-size: 11px; }
            }
        }

        HorizontalLayout {
            spacing: 10px;
            Text { text: "ВІДНОВЛЕННЯ ПЛАНУ WINDOWS"; color: #9eb6d2; font-size: 12px; font-weight: 700; }
            Button { text: "ПОВЕРНУТИ ПОЧАТКОВІ НАЛАШТУВАННЯ"; clicked => { root.restore-requested(); } }
        }

        Rectangle {
            background: #132c3c;
            border-radius: 9px;
            height: 43px;
            Text { text: root.status-text; color: #bce5e5; font-size: 12px; vertical-alignment: center; wrap: word-wrap; x: 12px; width: parent.width - 24px; }
        }
    }
}
